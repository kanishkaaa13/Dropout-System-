# ─────────────────────────────────────────────────────────────────────────────
# .gitignore
# JEE Dropout Prediction System — Python + Node + ML artefacts
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & secrets (NEVER commit these) ────────────────────────────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/

# ── ML model artefacts ────────────────────────────────────────────────────────
# .pkl files are large binaries — store in DVC or object storage instead
models/*.pkl
models/*.joblib
models/*.h5
models/*.onnx
# Keep metadata + gitkeep
!models/.gitkeep
!models/metadata.json

# ── Training data ─────────────────────────────────────────────────────────────
data/*.csv
data/*.xlsx
data/*.parquet
!data/.gitkeep

# ── Reports & uploads ─────────────────────────────────────────────────────────
reports/*.pdf
reports/*.xlsx
uploads/
!reports/.gitkeep

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
test_*.db
*.test.db

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
pyrightconfig.json

# ── Databases (dev SQLite files) ─────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Vite / React build output ─────────────────────────────────────────────────
frontend/dist/
frontend/.vite/
frontend/storybook-static/

# ── IDEs & editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Docker ────────────────────────────────────────────────────────────────────
# Don't ignore docker-compose.yml — it should be committed
# Ignore local overrides
docker-compose.override.yml
docker-compose.local.yml

# ── Alembic ───────────────────────────────────────────────────────────────────
# Keep migration scripts — ignore only generated artefacts
alembic/versions/__pycache__/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
