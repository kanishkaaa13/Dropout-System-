# JEE Dropout Prediction System — Environment Variables
# Copy this to .env and fill in real values before deploying.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development default — auto-created on first run)
DATABASE_URL=sqlite:///./jee_dropout.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/jee_dropout

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-OPENSSL-RAND-HEX-32

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── ML Configuration ───────────────────────────────────────────────────────────
MODEL_DIR=models
ARTIFACTS_DIR=artifacts
DATA_DIR=data
DROPOUT_PROBABILITY_THRESHOLD=0.5
HIGH_RISK_THRESHOLD=0.7
MEDIUM_RISK_THRESHOLD=0.5
LOW_RISK_THRESHOLD=0.3

# ── ML Model Selection ──────────────────────────────────────────────────────────
DEFAULT_MODEL=randomforest
AVAILABLE_MODELS=randomforest,xgboost,logisticregression

# ── Cross-Validation Settings ───────────────────────────────────────────────────
CV_FOLDS=5
USE_SMOTE=true
SMOTE_SAMPLING_STRATEGY=auto

# ── SHAP Settings ──────────────────────────────────────────────────────────────
ENABLE_SHAP=true
SHAP_PLOT_TYPE=waterfall
SAVE_SHAP_PLOTS=true

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
APP_NAME=JEE Dropout Prediction API
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list handled by Pydantic Settings list parsing
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── File Upload Settings ───────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=csv

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
