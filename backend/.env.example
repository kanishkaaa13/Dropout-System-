# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example
# Copy to .env and fill in real values before running docker-compose.
#
#   cp backend/.env.example backend/.env
#
# NEVER commit the real .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# For Docker: use the service name 'db' as the hostname.
# For local dev: use localhost:5432 or keep SQLite (sqlite:///./jee_dropout.db)
DATABASE_URL=postgresql+asyncpg://jee_user:changeme@db:5432/jee_dropout_db

# Postgres password (must match POSTGRES_PASSWORD in docker-compose.yml)
POSTGRES_PASSWORD=changeme

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string-before-deploying

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── ML Models ─────────────────────────────────────────────────────────────────
# Inside Docker the model_data volume is mounted at /app/models
MODEL_DIR=/app/models

# Minimum probability threshold to flag as at-risk
PREDICTION_THRESHOLD=0.35

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | staging | production
APP_NAME=JEE Dropout Prediction API
DEBUG=false

# Comma-separated list of allowed CORS origins (no trailing slash)
ALLOWED_ORIGINS=["http://localhost","http://localhost:5173","http://localhost:3000"]

# ── Institute ─────────────────────────────────────────────────────────────────
INSTITUTE_NAME=JEE Coaching Institute

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to disable all email sending (safe default).
# For Gmail: use an App Password (not your account password).
#   Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost
